{
  "tools": [
    {
      "_meta": {
        "fastmcp": {
          "tags": [
            "job",
            "search"
          ]
        }
      },
      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Search for jobs on LinkedIn.\n\nReturns job_ids that can be passed to get_job_details for full info.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "date_posted": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by posting date (past_hour, past_24_hours, past_week, past_month)"
          },
          "easy_apply": {
            "default": false,
            "description": "Only show Easy Apply jobs (default false)",
            "type": "boolean"
          },
          "experience_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by experience level, comma-separated (internship, entry, associate, mid_senior, director, executive)"
          },
          "job_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by job type, comma-separated (full_time, part_time, contract, temporary, volunteer, internship, other)"
          },
          "keywords": {
            "description": "Search keywords (e.g., \"software engineer\", \"data scientist\")",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional location filter (e.g., \"San Francisco\", \"Remote\")"
          },
          "max_pages": {
            "default": 3,
            "description": "Maximum number of result pages to load (1-10, default 3)",
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          },
          "sort_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Sort results (date, relevance)"
          },
          "work_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by work type, comma-separated (on_site, remote, hybrid)"
          }
        },
        "required": [
          "keywords"
        ],
        "type": "object"
      },
      "name": "search_jobs",
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Search Jobs"
    },
    {
      "_meta": {
        "fastmcp": {
          "tags": [
            "person",
            "search"
          ]
        }
      },
      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Search for people on LinkedIn.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "current_company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional current-employer filter. LinkedIn's\ncurrentCompany facet only filters on the numeric company URN id\n(e.g. \"1115\" for SAP); plain company names are accepted by the\nURL but ignored by LinkedIn and return the unfiltered result\nset. Look up a company's URN via get_company_profile -- it is\nexposed under references[\"about\"]. For company-wide employee\ndemographics (location/education/function breakdown) plus a\nslug-based lookup, use get_company_employees instead."
          },
          "keywords": {
            "description": "Search keywords (e.g., \"software engineer\", \"recruiter at Google\")",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional location filter (e.g., \"New York\", \"Remote\")"
          },
          "network": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional connection-degree filter. Each element is one of\n\"F\" (1st-degree), \"S\" (2nd-degree), \"O\" (3rd-degree and beyond).\nExample: [\"F\"] to only return 1st-degree connections."
          }
        },
        "required": [
          "keywords"
        ],
        "type": "object"
      },
      "name": "search_people",
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Search People"
    }
  ]
}
